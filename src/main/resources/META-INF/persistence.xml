<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">
    <!-- El mapeo se declara con anotaciones Jakarta en las entidades. -->
    <persistence-unit name="skillswap" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
        <class>ar.edu.uade.skillswap.dominio.perfil.Perfil</class>
        <class>ar.edu.uade.skillswap.dominio.perfil.Habilidad</class>
        <class>ar.edu.uade.skillswap.dominio.perfil.Reputacion</class>
        <class>ar.edu.uade.skillswap.dominio.publicacion.Publicacion</class>
        <class>ar.edu.uade.skillswap.dominio.publicacion.OfertaMentoria</class>
        <class>ar.edu.uade.skillswap.dominio.publicacion.OfertaServicio</class>
        <class>ar.edu.uade.skillswap.dominio.publicacion.Desafio</class>
        <class>ar.edu.uade.skillswap.dominio.publicacion.FranjaDisponibilidad</class>
        <class>ar.edu.uade.skillswap.dominio.publicacion.Promocion</class>
        <class>ar.edu.uade.skillswap.dominio.contratacion.Contratacion</class>
        <class>ar.edu.uade.skillswap.dominio.contratacion.HistorialEstado</class>
        <class>ar.edu.uade.skillswap.dominio.contratacion.Calificacion</class>
        <class>ar.edu.uade.skillswap.dominio.wallet.Wallet</class>
        <class>ar.edu.uade.skillswap.dominio.wallet.MovimientoCredito</class>
        <class>ar.edu.uade.skillswap.dominio.notificacion.Notificacion</class>
        <class>ar.edu.uade.skillswap.infraestructura.persistencia.SkillCoinsConverter</class>
        <class>ar.edu.uade.skillswap.infraestructura.persistencia.EstadoPublicacionConverter</class>
        <class>ar.edu.uade.skillswap.infraestructura.persistencia.EstadoContratacionConverter</class>
        <exclude-unlisted-classes>true</exclude-unlisted-classes>
        <properties>
            <property name="hibernate.hbm2ddl.auto" value="none"/>
            <property name="hibernate.show_sql" value="false"/>
            <property name="hibernate.connection.pool_size" value="10"/>
        </properties>
    </persistence-unit>
</persistence>
